# ── Required in production ────────────────────────────────────────────────
# >= 32 random chars:  openssl rand -hex 32
JWT_SECRET=
SUPABASE_URL=
# Preferred: server-side key. Enable RLS on tc_collections with NO public policies.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=            # legacy fallback only

# Telegram
TELEGRAM_BOT_TOKEN=
# Random string; used as setWebhook secret_token and verified on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Telegram numeric chat id of the store owner (replaces previously hardcoded ids)
OWNER_TELEGRAM_CHAT_ID=

# Protects /api/attendance/check-missing-alerts (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Extra browser origins allowed to call the API (same-origin is always allowed)
# ALLOWED_ORIGINS=https://example.com

# First-run only, when the users table is empty. Remove after the owner exists.
# BOOTSTRAP_OWNER_USERNAME=
# BOOTSTRAP_OWNER_PASSWORD=
# BOOTSTRAP_OWNER_TELEGRAM_CHAT_ID=
