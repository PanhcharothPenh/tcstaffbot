{
  "version": 2,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=*, geolocation=*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth-login"
    },
    {
      "source": "/api/auth/verify-2fa",
      "destination": "/api/auth-verify-2fa"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth-me"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth-logout"
    },
    {
      "source": "/api/auth/refresh-token",
      "destination": "/api/auth-refresh-token"
    },
    {
      "source": "/api/auth/forgot-password",
      "destination": "/api/auth-forgot-password"
    },
    {
      "source": "/api/auth/reset-password",
      "destination": "/api/auth-reset-password"
    },
    {
      "source": "/api/permissions",
      "destination": "/api/roles"
    },
    {
      "source": "/api/roles/:path*",
      "destination": "/api/roles"
    },
    {
      "source": "/api/users/:path*",
      "destination": "/api/users"
    },
    {
      "source": "/api/telegram-recipients/:path*",
      "destination": "/api/telegram-recipients"
    },
    {
      "source": "/api/telegram-schedules/:path*",
      "destination": "/api/telegram-schedules"
    },
    {
      "source": "/api/telegram-templates/:path*",
      "destination": "/api/telegram-templates"
    },
    {
      "source": "/api/attendance/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/admin/attendance/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/face/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/telegram/link",
      "destination": "/api/index"
    },
    {
      "source": "/api/telegram/unlink",
      "destination": "/api/index"
    },
    {
      "source": "/api/telegram/validate-init-data",
      "destination": "/api/index"
    },
    {
      "source": "/api/telegram/send-attendance-report",
      "destination": "/api/index"
    },
    {
      "source": "/api/resolve-maps-url",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
